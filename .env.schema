# Every environment variable Morrow reads, for the API and the web app.
# varlock validates this at startup (`varlock run`), types it (env.d.ts),
# redacts @sensitive values from logs and scans commits for leaks.
# Real values: `.env` / `.env.local` in development (git-ignored), Dokploy's
# environment UI in production. Never put a secret in this file.
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# @generateTsTypes(path=env.d.ts, auto=false)
# ---

# development | test | production
# @type=enum(development, test, production)
NODE_ENV=development

# ── Instance ────────────────────────────────────────────────────────────────

# Public origin of the instance. The API serves the web app, so there is one.
# In dev it is Caddy (HTTP/2) in front of the Vite server.
# @required @type=url
MORROW_CLIENT_URL=if(forEnv(production), undefined, https://localhost:5443)

# Public URL of the API. Same origin as the web app; the dev server proxies /api.
# @required @type=url
MORROW_API_URL=${MORROW_CLIENT_URL}/api

# Reverse-proxy network CIDRs trusted for client IPs (Dokploy/Traefik). Without
# it the proxy address counts as every visitor and rate limits collapse. Never
# all addresses.
TRUSTED_PROXIES=

# ── Database ────────────────────────────────────────────────────────────────

# PostgreSQL connection URL (the Dokploy database service in production).
# @required @type=url @sensitive=forEnv(production)
DATABASE_URL=if(forEnv(production), undefined, postgresql://morrow:morrow_local_dev@localhost:5432/morrow)

# ── Sync (Electric) ─────────────────────────────────────────────────────────

# Internal URL of the Electric sync service. Morrow proxies browser shape
# requests to it, so it is never exposed publicly.
# @required @type=url
ELECTRIC_URL=if(forEnv(production), undefined, http://127.0.0.1:3010)
# Authenticates Morrow to Electric; must equal Electric's ELECTRIC_SECRET.
# @required @sensitive=forEnv(production)
ELECTRIC_SECRET=if(forEnv(production), undefined, morrow_local_electric_secret)

# ── Documents (Durable Streams) ─────────────────────────────────────────────

# Internal URL of the Durable Streams server that keeps the pages' update logs.
# Only the API reaches it, through the page proxy; it is never exposed publicly.
# @required @type=url
DURABLE_STREAMS_URL=if(forEnv(production), undefined, http://127.0.0.1:4437)

# ── Accounts ────────────────────────────────────────────────────────────────

# Signs sessions. Generate with `openssl rand -hex 32` and keep it stable.
# @required=not(forEnv(test)) @sensitive @type=string(minLength=32)
AUTH_SECRET=

# Comma-separated emails that are administrators. Only a verified session email
# matches, so admin rights survive a database restore.
ADMIN_EMAILS=

# Set to false and restart to close sign-ups (invited addresses can still join).
# @type=boolean
REGISTRATION_OPEN=true

# Workspaces a user may own. Administrators are exempt.
# @type=number(min=1, isInt=true)
MAX_WORKSPACES_PER_USER=3

# Sign in with Google (leave empty to hide).
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

# Sign in with GitHub (OAuth App; leave empty to hide).
GITHUB_CLIENT_ID=
# @sensitive
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile secret. Enforced on code requests and social sign-in
# when set.
# @sensitive
TURNSTILE_SECRET_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────────

# Sign-in codes and invitations are emailed, so production needs both.
# Elsewhere, with no key, emails are written to the API log instead.
# @required=and(forEnv(production), not($MORROW_EMAIL_CONSOLE)) @sensitive
RESEND_API_KEY=
# @required=and(forEnv(production), not($MORROW_EMAIL_CONSOLE))
EMAIL_FROM=

# Log emails instead of sending them, even in production. For throwaway test
# stacks only.
# @type=boolean
MORROW_EMAIL_CONSOLE=false

# ── Storage (Cloudflare R2 or any S3-compatible store) ──────────────────────
# Avatars are public objects served from S3_PUBLIC_BASE_URL (an R2 custom
# domain, or MinIO in dev and tests); workspace assets use presigned URLs.
# Without S3_ENDPOINT, S3_BUCKET and the credentials, avatar uploads answer
# "storage unavailable".

S3_ENDPOINT=if(forEnv(production), undefined, http://127.0.0.1:9020)
S3_BUCKET=if(forEnv(production), undefined, morrow)
# @sensitive=forEnv(production)
S3_ACCESS_KEY_ID=if(forEnv(production), undefined, morrow)
# @sensitive=forEnv(production)
S3_SECRET_ACCESS_KEY=if(forEnv(production), undefined, morrow_local_dev)
# `auto` for R2.
S3_REGION=us-east-1
# @type=boolean
S3_FORCE_PATH_STYLE=true
# @type=number(min=1, isInt=true)
S3_PRESIGN_TTL_SECONDS=300
S3_KEY_PREFIX=
# Public base of the bucket, with no trailing slash. Required for avatars.
# Development points at the Compose MinIO from `pnpm dev:services`.
S3_PUBLIC_BASE_URL=if(forEnv(production), undefined, http://127.0.0.1:9020/morrow)

# ── Sentry ──────────────────────────────────────────────────────────────────

# API error reporting; disabled when empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# @type=number(min=0, max=1)
SENTRY_TRACES_SAMPLE_RATE=0
# @type=number(min=0, max=1)
SENTRY_PROFILES_SAMPLE_RATE=0
# Git SHA; ties events to source maps.
SENTRY_RELEASE=
# Build-time source map upload.
# @sensitive
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Web app (build-time, public) ────────────────────────────────────────────

# Only when the API is hosted on another origin. Empty means same-origin.
VITE_API_URL=
# Turnstile site key matching TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=
# Browser error reporting; disabled when empty.
VITE_SENTRY_DSN=

