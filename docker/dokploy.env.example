# Paste into the Environment tab of the Dokploy compose service
# (compose.dokploy.yml) and fill in. Every variable is described in .env.schema.
# `<db-app-name>` is the database service's internal host, shown on its page.

# Image tag: `latest`, or `sha-<7-character commit>` to pin or roll back.
MORROW_IMAGE_TAG=latest

MORROW_CLIENT_URL=https://morrow.example.com
# Subnet of dokploy-network: docker network inspect dokploy-network
TRUSTED_PROXIES=10.0.1.0/24

DATABASE_URL=postgresql://morrow:<password>@<db-app-name>:5432/morrow?sslmode=disable
# The same database as the `electric` role (docs/runbook.md#electric-sync).
ELECTRIC_DATABASE_URL=postgresql://electric:<password>@<db-app-name>:5432/morrow?sslmode=disable
# openssl rand -hex 32
ELECTRIC_SECRET=

# openssl rand -hex 32; keep it stable.
AUTH_SECRET=
ADMIN_EMAILS=you@example.com
REGISTRATION_OPEN=true

RESEND_API_KEY=
EMAIL_FROM=Morrow <morrow@example.com>

# Cloudflare R2. Token scoped to this bucket with Object Read & Write.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=morrow
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# The bucket's custom domain, no trailing slash.
S3_PUBLIC_BASE_URL=https://files.example.com

# Optional.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
