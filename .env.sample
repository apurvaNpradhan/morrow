# Copy to `.env` (git-ignored) and fill in the values you need. Every variable,
# its type and whether it is required is declared in `.env.schema`; varlock
# validates this file against it when the API or web app starts.
#
# Run `pnpm exec varlock load` to check your configuration (secrets are masked).

# Required. Signs sessions: `openssl rand -hex 32`, then keep it stable.
AUTH_SECRET=

# Emails that are instance administrators (comma-separated, verified emails only).
ADMIN_EMAILS=

# Defaults suit local development; override only if yours differ.
# DATABASE_URL=   # defaults to the local compose Postgres
# MORROW_CLIENT_URL=http://localhost:5173

# Sign in with Google / GitHub (optional).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email via Resend. With no key outside production, emails are printed to the
# API log, so you can copy sign-in codes from there.
# RESEND_API_KEY=
# EMAIL_FROM=

# File storage (R2 or any S3-compatible store). Development defaults to the
# MinIO from `pnpm dev:services`.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=   # public bucket URL; avatars are served from it
